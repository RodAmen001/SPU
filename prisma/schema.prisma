// SPU v4.4 — Schéma logique (Partie 14 du cahier des charges)
// SQLite en prévisualisation ; migrable vers PostgreSQL + pgvector sans changer l'API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 14.1 — Table "paraboles"
// (SQLite : pas d'ENUM ni de VECTOR natif → statut/mode en String, embedding TF-IDF en JSON String.
//  Migration pgvector : remplacer vec par embedding VECTOR(1024), schéma API inchangé.)
model Parabole {
  id             String    @id @default(uuid())
  code           String    @unique
  texte          String
  culture        String
  famille        String
  interpretations String // JSON: string[]
  sources        String // JSON: string[]
  statut         String    @default("validated") // validated | pending | rejected
  mode           String    @default("adulte") // adulte | enfant
  vec            String    @default("[]") // JSON: number[] (index TF-IDF pondéré)
  motsCles       String    @default("[]") // JSON: string[] (mots-clés éditoriaux de pré-indexation)
  dateAjout      DateTime  @default(now())
  dateValidation DateTime?
  validateur     String?
  echanges       Echange[]
}

// 14.2 — Table "sessions"
model Session {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  mode       String    @default("oracle") // oracle | mentor | deep | enfant
  anonymized Boolean   @default(true)
  userConsent Boolean  @default(false)
  expiresAt  DateTime
  mentorState String? // JSON: état du dialogue Mentor (étape, historique)
  deepState  String? // JSON: état du parcours Deep (niveau courant)
  userId     String? // présent si la session est rattachée à un compte SPU
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  echanges   Echange[]
}

// Compte SPU — export et conservation des sessions sur le compte de l'utilisateur.
// Authentification légère : pseudo + scrypt (node:crypto), token en mémoire serveur.
model User {
  id             String    @id @default(uuid())
  pseudo         String    @unique
  motDePasseHash String
  createdAt      DateTime  @default(now())
  dernierAcces   DateTime  @default(now())
  sessions       Session[]
  sauvegardes    Sauvegarde[]
}

// Sauvegardes instantanées du journal — export/import restaurable par l'utilisateur.
model Sauvegarde {
  id         String   @id @default(uuid())
  compteId   String
  compte     User     @relation(fields: [compteId], references: [id], onDelete: Cascade)
  titre      String
  mode       String   @default("oracle")
  nbEchanges Int      @default(0)
  payload    String // JSON: journal complet {exporte, mode, echanges[]}
  createdAt  DateTime @default(now())
}

// 14.3 — Table "echanges"
model Echange {
  id             String    @id @default(uuid())
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       String?
  synthese       String?
  sourcesReponse String? // JSON: string[]
  paraboleId     String?
  parabole       Parabole? @relation(fields: [paraboleId], references: [id])
  interpretation String?
  histoire       String?
  audioActive    Boolean   @default(false)
  distressFlagged Boolean  @default(false)
  mode           String    @default("oracle")
  etape          Int       @default(1) // étape Mentor (1-3) ou niveau Deep (1-3)
  payload        String? // JSON: données additionnelles (questions d'angle, confiance…)
  createdAt      DateTime  @default(now())
}

// 14.4 — Table "sources_cache" (cache 24 h par hash de question)
model SourcesCache {
  id              String   @id @default(uuid())
  questionHash    String
  sourceName      String
  responsePayload String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([questionHash, sourceName])
}

// 14.5 — Table "quarantaine" (candidates externes, workflow de validation)
model Quarantaine {
  id                  String    @id @default(uuid())
  texte               String
  culture             String
  sourceUrl           String?
  sourceSecondaireUrl String?
  statut              String    @default("pending") // pending | validated | rejected
  motifRejet          String?
  createdAt           DateTime  @default(now())
  reviewedAt          DateTime?
}

// 14.6 — Table "logs_detresse" — AUCUNE donnée textuelle stockée ici.
model LogsDetresse {
  id           String   @id @default(uuid())
  questionHash String
  scoreCoucheA Float
  scoreCoucheB Float
  scoreCoucheC Float
  decision     String // distress | review | pass
  createdAt    DateTime @default(now())
}
